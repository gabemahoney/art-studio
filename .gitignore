.DS_Store

# API keys — never commit (gen.py reads ~/.config/art-studio/openai.key instead)
*.key

__pycache__/
*.pyc

# This repo holds no project content, so it holds no images. A second line of
# defence against a stray render being committed by accident.
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.tif
*.tiff
*.bmp
*.psd

# Skills live in skills/ as repo content. These are per-tool install locations —
# symlink or copy from skills/ into whichever your agent reads. Never committed, so
# each user chooses global (~/.claude/skills/) or per-project placement.
.claude/
.agents/

# Obsidian editor state — personal, never published
.obsidian/

# SDLC worktrees and bees ticket hives — local workflow state, never published
/.worktrees/
/tickets/
